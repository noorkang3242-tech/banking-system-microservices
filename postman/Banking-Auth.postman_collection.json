          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/transfers", "host": ["{{baseUrl}}"], "path": ["api","transfers"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('admin 200', () => pm.response.to.have.status(200));"
          ] } } ]
        }
      ]
    },
    {
      "name": "6. Loan",
      "description": "Loan lifecycle. Pehle folder 3 ya 5 se ek account ban jaaye (fromAccount/accountNumber). Run order: apply -> admin approve -> repay.",
      "item": [
        {
          "name": "Setup: open account (2000) -> loanAccount",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api","accounts"] },
            "body": { "mode": "raw", "raw": "{\n  \"accountType\": \"SAVINGS\",\n  \"initialDeposit\": 2000.00\n}" }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('loanAccount', pm.response.json().accountNumber);"
          ] } } ]
        },
        {
          "name": "Apply loan (10000 / 12mo / 10%) -> loanId",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/loans", "host": ["{{baseUrl}}"], "path": ["api","loans"] },
            "body": { "mode": "raw", "raw": "{\n  \"accountNumber\": \"{{loanAccount}}\",\n  \"principal\": 10000.00,\n  \"termMonths\": 12,\n  \"interestRate\": 10.00,\n  \"purpose\": \"Car\"\n}" }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 201', () => pm.response.to.have.status(201));",
            "const j = pm.response.json(); pm.collectionVariables.set('loanId', j.loanId);",
            "pm.test('PENDING', () => pm.expect(j.status).to.eql('PENDING'));"
          ] } } ]
        },
        {
          "name": "Customer approve (forbidden -> 403)",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/loans/{{loanId}}/approve", "host": ["{{baseUrl}}"], "path": ["api","loans","{{loanId}}","approve"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('customer 403', () => pm.response.to.have.status(403));"
          ] } } ]
        },
        {
          "name": "Admin approve + disburse (ACTIVE)",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/loans/{{loanId}}/approve", "host": ["{{baseUrl}}"], "path": ["api","loans","{{loanId}}","approve"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('ACTIVE', () => pm.expect(j.status).to.eql('ACTIVE'));",
            "pm.test('totalPayable 11000', () => pm.expect(Number(j.totalPayable)).to.eql(11000));"
          ] } } ]
        },
        {
          "name": "Repay 5000",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/loans/{{loanId}}/repay", "host": ["{{baseUrl}}"], "path": ["api","loans","{{loanId}}","repay"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 5000.00\n}" }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('outstanding 6000', () => pm.expect(Number(pm.response.json().outstanding)).to.eql(6000));"
          ] } } ]
        },
        {
          "name": "Repay rest (clamps -> CLOSED)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/loans/{{loanId}}/repay", "host": ["{{baseUrl}}"], "path": ["api","loans","{{loanId}}","repay"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 999999.00\n}" }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('CLOSED', () => pm.expect(pm.response.json().status).to.eql('CLOSED'));"
          ] } } ]
        },
        {
          "name": "My loans (/me)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/loans/me", "host": ["{{baseUrl}}"], "path": ["api","loans","me"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ] } } ]
        },
        {
          "name": "Staff: all loans (ADMIN -> 200)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/loans", "host": ["{{baseUrl}}"], "path": ["api","loans"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('admin 200', () => pm.response.to.have.status(200));"
          ] } } ]
        }
      ]
    },
    {
      "name": "7. Card",
      "description": "Card issue/manage. CREDIT needs no account; DEBIT needs your own accountNumber.",
      "item": [
        {
          "name": "Issue CREDIT card (full number + CVV once) -> cardId",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/cards", "host": ["{{baseUrl}}"], "path": ["api","cards"] },
            "body": { "mode": "raw", "raw": "{\n  \"cardType\": \"CREDIT\",\n  \"cardholderName\": \"ALI KHAN\"\n}" }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 201', () => pm.response.to.have.status(201));",
            "const j = pm.response.json(); pm.collectionVariables.set('cardId', j.cardId);",
            "pm.test('16-digit PAN', () => pm.expect(j.cardNumber.length).to.eql(16));",
            "pm.test('CVV present once', () => pm.expect(j.cvv).to.be.a('string'));"
          ] } } ]
        },
        {
          "name": "My cards (masked, no CVV)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/cards/me", "host": ["{{baseUrl}}"], "path": ["api","cards","me"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const a = pm.response.json();",
            "pm.test('masked PAN', () => pm.expect(a[0].maskedNumber).to.include('****'));",
            "pm.test('no CVV leaked', () => pm.expect(a[0].cvv).to.be.undefined);"
          ] } } ]
        },
        {
          "name": "Block card",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/cards/{{cardId}}/block", "host": ["{{baseUrl}}"], "path": ["api","cards","{{cardId}}","block"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('BLOCKED', () => pm.expect(pm.response.json().status).to.eql('BLOCKED'));"
          ] } } ]
        },
        {
          "name": "Unblock card",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/cards/{{cardId}}/unblock", "host": ["{{baseUrl}}"], "path": ["api","cards","{{cardId}}","unblock"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('ACTIVE', () => pm.expect(pm.response.json().status).to.eql('ACTIVE'));"
          ] } } ]
        },
        {
          "name": "Issue DEBIT without accountNumber (-> 400)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/cards", "host": ["{{baseUrl}}"], "path": ["api","cards"] },
            "body": { "mode": "raw", "raw": "{\n  \"cardType\": \"DEBIT\"\n}" }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('DEBIT needs account -> 400', () => pm.response.to.have.status(400));"
          ] } } ]
        },
        {
          "name": "Staff: all cards (ADMIN -> 200)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/cards", "host": ["{{baseUrl}}"], "path": ["api","cards"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('admin 200', () => pm.response.to.have.status(200));"
          ] } } ]
        }
      ]
    },
    {
      "name": "8. Notification",
      "description": "Notifications appear automatically after transfer/loan/card events. Staff can send directly. Run folders 5/6/7 first to generate some.",
      "item": [
        {
          "name": "My notifications",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/notifications/me", "host": ["{{baseUrl}}"], "path": ["api","notifications","me"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const a = pm.response.json(); if (a.length) pm.collectionVariables.set('notificationId', a[0].notificationId);"
          ] } } ]
        },
        {
          "name": "Unread count",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/notifications/me/unread-count", "host": ["{{baseUrl}}"], "path": ["api","notifications","me","unread-count"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has unread field', () => pm.expect(pm.response.json()).to.have.property('unread'));"
          ] } } ]
        },
        {
          "name": "Staff send (SECURITY alert) -> recipient = me",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/notifications/send", "host": ["{{baseUrl}}"], "path": ["api","notifications","send"] },
            "body": { "mode": "raw", "raw": "{\n  \"recipientUserId\": \"{{myUserId}}\",\n  \"type\": \"SECURITY\",\n  \"title\": \"New login\",\n  \"message\": \"A new device logged into your account.\"\n}" }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 201', () => pm.response.to.have.status(201));"
          ] } } ]
        },
        {
          "name": "Mark one read",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/notifications/{{notificationId}}/read", "host": ["{{baseUrl}}"], "path": ["api","notifications","{{notificationId}}","read"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('READ', () => pm.expect(pm.response.json().status).to.eql('READ'));"
          ] } } ]
        },
        {
          "name": "Mark all read",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/notifications/read-all", "host": ["{{baseUrl}}"], "path": ["api","notifications","read-all"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ] } } ]
        },
        {
          "name": "Customer send (forbidden -> 403)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/notifications/send", "host": ["{{baseUrl}}"], "path": ["api","notifications","send"] },
            "body": { "mode": "raw", "raw": "{\n  \"recipientUserId\": \"{{myUserId}}\",\n  \"type\": \"GENERAL\",\n  \"title\": \"t\",\n  \"message\": \"m\"\n}" }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('customer 403', () => pm.response.to.have.status(403));"
          ] } } ]
        }
      ]
    }
  ]
