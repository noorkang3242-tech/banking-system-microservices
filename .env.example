# ─────────────────────────────────────────────────────────────────────────────
#  Banking System — environment configuration reference
#  Copy the values you need into your shell / process environment before starting
#  the services. NEVER commit real production secrets to source control.
#  (start-all.ps1 reads these from the environment; if unset it uses LOCAL-DEV
#   fallbacks that are safe for a laptop but must be overridden in production.)
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (MySQL) ---
DB_USERNAME=root
DB_PASSWORD=change-me

# --- JWT signing key (auth-service issues, api-gateway verifies) ---
# MUST be identical in auth-service and api-gateway. >= 32 chars (HS256).
JWT_SECRET=replace-with-a-long-random-64-char-secret
JWT_EXPIRATION_MS=86400000

# --- Internal gateway<->service shared secret ---
# Stamped by the gateway on every forwarded request; every service rejects any
# direct call that does not carry it. MUST be identical across the gateway and
# all 8 business services.
INTERNAL_SHARED_SECRET=replace-with-a-long-random-secret

# --- Seeded ADMIN account (created at auth-service startup) ---
# This is the ONLY way staff are created now that /register is CUSTOMER-only.
# Leave unset to skip seeding (no insecure default admin is ever created).
ADMIN_EMAIL=admin@bank.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# --- Eureka discovery (optional override) ---
# EUREKA_URL=http://localhost:8761/eureka/

# --- Notification rate limit (optional override) ---
# NOTIFICATION_RATE_LIMIT_MAX_PER_MINUTE=20

# ─────────────────────────────────────────────────────────────────────────────
#  Cloud deployment (docker compose) only — see DEPLOYMENT.md
# ─────────────────────────────────────────────────────────────────────────────
# DOMAIN: a hostname pointing at this server. Caddy then gets free HTTPS.
#   e.g. noorbank.duckdns.org   (use ":80" to test over plain http by IP first)
DOMAIN=:80
# PUBLIC_URL: the exact URL users open. Builds the frontend + allows CORS.
#   e.g. https://noorbank.duckdns.org   (or http://YOUR.SERVER.IP for a quick test)
PUBLIC_URL=http://localhost
